{
  "name": "battery-control",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ionic serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:android": "ng build --configuration production && npx cap sync android",
    "build:apk": "ng build --configuration production && npx cap sync android && cd android && gradlew.bat assembleDebug && powershell -ExecutionPolicy Bypass -File scripts/copy-apk.ps1 -BuildType debug",
    "build:apk:release": "ng build --configuration production && npx cap sync android && cd android && gradlew.bat assembleRelease && powershell -ExecutionPolicy Bypass -File scripts/copy-apk.ps1 -BuildType release",
    "copy:apk": "powershell -ExecutionPolicy Bypass -File scripts/copy-apk.ps1 -BuildType debug",
    "copy:apk:release": "powershell -ExecutionPolicy Bypass -File scripts/copy-apk.ps1 -BuildType release",
    "android": "npx cap open android",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "test:visual": "npx playwright test",
    "test:visual:ui": "npx playwright test --ui",
    "test:visual:report": "npx playwright show-report",
    "test:visual:debug": "npx playwright test --debug",
    "test:visual:update": "npx playwright test --update-snapshots"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/platform-browser-dynamic": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^9.0.2",
    "cordova-plugin-background-mode": "^0.7.3",
    "cordova-plugin-device": "^3.0.0",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.11.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "~10.9.0",
    "typescript": "~6.0.0"
  },
  "description": "An Ionic project"
}
